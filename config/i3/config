# =============================================================================
# i3 window manager — managed by the superiority-complex dotfiles.
#
# This file is symlinked to ~/.config/i3/config by modules/60-i3.sh.
# Edit it here (in the repo) and reload with $mod+Shift+r.
#
# Plasma is still installed: pick it at the SDDM login screen to fall back.
# =============================================================================

# Super as the modifier (Alt is left free for applications).
set $mod Mod4

font pango:DejaVu Sans Mono 10

# --- Autostart ---------------------------------------------------------------
# Compositor (tear-free rendering, shadows).
exec --no-startup-id picom -b
# Network + audio trays, and the KDE polkit agent for authentication prompts.
exec --no-startup-id nm-applet
exec --no-startup-id /usr/lib/polkit-kde-authentication-agent-1
# Notifications.
exec --no-startup-id dunst
# Lock on idle/suspend; i3lock is driven by xss-lock.
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork --color 1a1b26
# Wallpaper: use ~/.config/i3/wallpaper if present, else a flat Tokyonight bg.
exec --no-startup-id sh -c 'feh --bg-fill ~/.config/i3/wallpaper 2>/dev/null || xsetroot -solid "#1a1b26"'

# --- Launching ---------------------------------------------------------------
bindsym $mod+Return exec konsole
bindsym $mod+d      exec --no-startup-id rofi -show drun
bindsym $mod+Tab    exec --no-startup-id rofi -show window
bindsym $mod+q      kill
bindsym $mod+Shift+q kill

# Screenshots: whole screen, or a selected region, straight to the clipboard.
bindsym Print       exec --no-startup-id maim | xclip -selection clipboard -t image/png
bindsym $mod+Print  exec --no-startup-id maim --select | xclip -selection clipboard -t image/png

# Lock manually.
bindsym $mod+Shift+x exec --no-startup-id i3lock --color 1a1b26

# --- Focus -------------------------------------------------------------------
# Vim keys, with the arrow keys kept as a fallback.
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# --- Moving ------------------------------------------------------------------
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# --- Layout ------------------------------------------------------------------
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Drag floating windows with the modifier held.
floating_modifier $mod

# --- Workspaces --------------------------------------------------------------
set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# --- Media / volume keys -----------------------------------------------------
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute        exec --no-startup-id wpctl set-mute   @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute     exec --no-startup-id wpctl set-mute   @DEFAULT_AUDIO_SOURCE@ toggle
bindsym $mod+Shift+a exec --no-startup-id pavucontrol

# --- Resize ------------------------------------------------------------------
mode "resize" {
        bindsym h resize shrink width  10 px or 10 ppt
        bindsym j resize grow   height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow   width  10 px or 10 ppt

        bindsym Left  resize shrink width  10 px or 10 ppt
        bindsym Down  resize grow   height 10 px or 10 ppt
        bindsym Up    resize shrink height 10 px or 10 ppt
        bindsym Right resize grow   width  10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# --- Session -----------------------------------------------------------------
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"

# --- Appearance (Tokyonight, to match Neovim) --------------------------------
# class                 border  backgr. text    indicator child_border
client.focused          #7aa2f7 #7aa2f7 #1a1b26 #bb9af7   #7aa2f7
client.focused_inactive #414868 #414868 #c0caf5 #414868   #414868
client.unfocused        #24283b #24283b #a9b1d6 #24283b   #24283b
client.urgent           #f7768e #f7768e #1a1b26 #f7768e   #f7768e

default_border pixel 2
gaps inner 6
gaps outer 2
smart_gaps on

# --- Status bar --------------------------------------------------------------
bar {
        status_command i3status -c ~/.config/i3status/config
        position top
        tray_output primary

        colors {
                background #1a1b26
                statusline #c0caf5
                separator  #414868

                # class            border  backgr. text
                focused_workspace  #7aa2f7 #7aa2f7 #1a1b26
                active_workspace   #414868 #414868 #c0caf5
                inactive_workspace #24283b #24283b #a9b1d6
                urgent_workspace   #f7768e #f7768e #1a1b26
        }
}
